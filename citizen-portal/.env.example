# Copy to .env and fill in real values from each agent's Overview page in Agent Manager
# (Invoke URL + API Key). Any agent left blank, or with a REPLACE_WITH_* placeholder,
# automatically falls back to the scripted mock engine (src/mock/agentMocks.js) — see
# src/services/agentApi.js for the fallback logic. 8 instances total, per PLAN.md §5/§6.

# --- Citizen Inquiry Agent — 5 department instances ---
VITE_AGENT_CITIZEN_INQUIRY_CONTACT_CENTER_URL=
VITE_AGENT_CITIZEN_INQUIRY_CONTACT_CENTER_API_KEY=

VITE_AGENT_CITIZEN_INQUIRY_SOCIAL_SERVICES_URL=
VITE_AGENT_CITIZEN_INQUIRY_SOCIAL_SERVICES_API_KEY=

VITE_AGENT_CITIZEN_INQUIRY_PERMITS_LICENSING_URL=
VITE_AGENT_CITIZEN_INQUIRY_PERMITS_LICENSING_API_KEY=

VITE_AGENT_CITIZEN_INQUIRY_TAX_REVENUE_URL=
VITE_AGENT_CITIZEN_INQUIRY_TAX_REVENUE_API_KEY=

VITE_AGENT_CITIZEN_INQUIRY_RECORDS_COMPLIANCE_URL=
VITE_AGENT_CITIZEN_INQUIRY_RECORDS_COMPLIANCE_API_KEY=

# --- Case Management Agent — 1 instance, Social Services only ---
VITE_AGENT_CASE_MANAGEMENT_URL=
VITE_AGENT_CASE_MANAGEMENT_API_KEY=

# --- Permit & Licensing Agent — 2 instances, both under Permits & Licensing ---
VITE_AGENT_PERMIT_LICENSING_BUILDING_URL=
VITE_AGENT_PERMIT_LICENSING_BUILDING_API_KEY=

VITE_AGENT_PERMIT_LICENSING_BUSINESS_URL=
