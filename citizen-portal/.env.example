# Copy to .env and fill in real values from each agent's Overview page in Agent Manager
# (Invoke URL + API Key). Any agent left blank, or with a REPLACE_WITH_* placeholder,
# automatically falls back to the scripted mock engine (src/mock/agentMocks.js) — see
# src/services/agentApi.js for the fallback logic.

VITE_AGENT_CITIZEN_INQUIRY_URL=
VITE_AGENT_CITIZEN_INQUIRY_API_KEY=

VITE_AGENT_BENEFITS_ELIGIBILITY_URL=
VITE_AGENT_BENEFITS_ELIGIBILITY_API_KEY=

VITE_AGENT_CASE_MANAGEMENT_URL=
VITE_AGENT_CASE_MANAGEMENT_API_KEY=

VITE_AGENT_PERMITS_BUILDING_URL=
VITE_AGENT_PERMITS_BUILDING_API_KEY=

VITE_AGENT_PERMITS_BUSINESS_URL=
VITE_AGENT_PERMITS_BUSINESS_API_KEY=

VITE_AGENT_TAX_ASSISTANCE_URL=
VITE_AGENT_TAX_ASSISTANCE_API_KEY=

VITE_AGENT_RECORDS_FOIA_URL=
VITE_AGENT_RECORDS_FOIA_API_KEY=
