# Ballerina has no dotenv loader — os:getEnv reads plain env vars, so use ./run.sh (which
# sources this file), or `export $(grep -v '^#' .env | xargs)` before `bal run`.

COUNTY_NAME="Riverside County"

# --- case store (this is the agent that owns it) ------------------------------------------
# Default is this agent's own SQLite file, seeded from seed/*.json on startup, so the agent
# runs with nothing else alive. Point it at
# ../../mcp-servers/case-management-mcp-server/data/case_mgmt.db to share the MCP twin's
# database — same schema, same Fernet field encryption, so both agents can read and write it.
CASEMGMT_DB_PATH="data/case_mgmt.db"
CASEMGMT_SEED_DIR="seed"
CASEMGMT_SEED_ON_START="true"

# Field-level encryption key for citizen PII and case-note content. REQUIRED — the agent
# refuses to start without it. Must be the same key as the database it opens; generate a new
# one for a fresh database with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CASEMGMT_ENCRYPTION_KEY=""

# Optional: override the on-behalf-of token -> caseworker map. Same JSON shape as the MCP
# twin's CASEMGMT_OBO_TOKENS_JSON, so one value works for both. Defaults to the two
# fictional caseworkers in config.bal.
# CASEMGMT_OBO_TOKENS_JSON='{"obo_joan_ellis_4a7c9f":{"caseworker_id":"joan.ellis","name":"Joan Ellis"}}'

# --- LLM -----------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- logging -------------------------------------------------------------------------------
# ERROR | WARN | INFO | DEBUG (default INFO). run.sh maps this to Ballerina's
# BAL_CONFIG_VAR_BALLERINA_LOG_LEVEL. See observability.bal for what each level covers.
LOG_LEVEL="INFO"

# NOTE: there is no MCP_SERVER_URL and no AMP_AGENTID_* here, unlike ../case-management-agent.
# This agent makes no outbound MCP call, so it has no MCP proxy to authenticate to.

# Port is a Ballerina *configurable* (must be statically resolvable for Agent Manager's build
# step), not a plain env var — override with BAL_CONFIG_VAR_PORT, not PORT. AM always deploys
# on the default (8000).
# BAL_CONFIG_VAR_PORT=8000
