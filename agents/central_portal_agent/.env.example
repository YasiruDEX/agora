PORT=8007
DEPARTMENT_NAME="Government Information Center (GIC 1919)"
DEPARTMENT_CODE="GIC"
# NOTE: the task spec for this agent listed "citizen-inquiry" as the 5th
# namespace, but the live Pinecone index (verified via describe_index_stats)
# only has these 5: permits-licensing, tax-revenue, social-services,
# records-compliance, health-environment. "citizen-inquiry" isn't a real
# namespace anywhere in this repo -- searching it always returns zero
# results. Using health-environment here so the agent actually works;
# override if you really do want a 5th "citizen-inquiry" namespace ingested.
ALL_NAMESPACES="tax-revenue,social-services,permits-licensing,records-compliance,health-environment"
# Pinecone cosine-similarity scores are usually 0.4-0.6 for a genuinely
# relevant chunk and 0.15-0.35 for an unrelated namespace's nearest (but
# irrelevant) neighbor -- see agents/central_portal_agent/tools.py's
# build_search_all_government_knowledge_tool docstring. Only applied when
# fanning out across every namespace, never to an explicitly-scoped one.
KB_MIN_RELEVANCE_SCORE="0.4"
WELCOME_MESSAGE="Ayubowan! I am your Central Government Information Assistant. Ask me anything about municipal rates, welfare benefits, building permits, business licenses, or public records."
SUPPORT_EMAIL_CONTACT="info@gic.gov.lk"
OFFICE_HOURS_INFO="24/7 Government Hotline 1919"
LLM_PROVIDER_KEY="azure-openai-gov"
LLM_MODEL_NAME="gpt-4o"
MODEL_TEMPERATURE="0.1"
MAX_TOKENS="1000"
