# Department Configuration Parameters
DEPARTMENT_NAME="Permits & Licensing Department"
DEPARTMENT_CODE="PL"
KB_NAMESPACE="permits-licensing"
WELCOME_MESSAGE="Hello! I can assist you with Building Plan approvals, Setback Line certificates, and Business License applications."
SUPPORT_EMAIL_CONTACT="permits@riversidecounty.gov"
OFFICE_HOURS_INFO="Weekdays 9:00 AM - 3:00 PM"

# Agent-to-Agent Communication
INQUIRY_AGENT_URL="http://localhost:8001/chat"

# Remote MCP Server Endpoints (SSE). Point these at wherever the MCP servers
# are actually deployed (e.g. an Agent Manager MCP proxy in front of each) —
# defaults assume each is running locally with MCP_TRANSPORT=sse for testing.
# When running the Building Permits / Business Licenses instances, override
# PERMIT_DB_MCP_URL per-instance in .env.building_permits / .env.business_licenses.
KB_MCP_URL="http://localhost:9001/sse"
PERMIT_DB_MCP_URL="http://localhost:9004/sse"

# Model & Execution Runtime Settings
LLM_PROVIDER_KEY="azure-openai-gov"
LLM_MODEL_NAME="gpt-4o"
MODEL_TEMPERATURE="0.1"
MAX_TOKENS="1000"

# Server Runtime
PORT="8000"
