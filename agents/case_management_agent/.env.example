PORT=8005
DEPARTMENT_NAME="Department of Social Services"
DEPARTMENT_CODE="SOC_CASE"
KB_NAMESPACE="social-services"
WELCOME_MESSAGE="Ayubowan! I am your Case Management Assistant. I can help summarize case histories, review notes, and draft next steps."
SUPPORT_EMAIL_CONTACT="cases@council.gov.lk"
OFFICE_HOURS_INFO="Weekdays 9:00 AM - 3:00 PM"
INQUIRY_AGENT_URL="http://localhost:8001/chat"

# Remote MCP Server Endpoints (SSE). Point these at wherever the MCP servers
# are actually deployed (e.g. an Agent Manager MCP proxy in front of each) —
# defaults assume each is running locally with MCP_TRANSPORT=sse for testing.
KB_MCP_URL="http://localhost:9001/sse"
CASE_DB_MCP_URL="http://localhost:9003/sse"

LLM_PROVIDER_KEY="onprem-vllm"
LLM_MODEL_NAME="llama-3-70b-instruct"
MODEL_TEMPERATURE="0.1"
MAX_TOKENS="1000"

# Optional: OpenAI-compatible base URL for the on-prem vLLM endpoint declared
# by LLM_PROVIDER_KEY above. Leave unset to fall back to the public OpenAI API
# (in which case LLM_MODEL_NAME must be a real OpenAI model, not the on-prem
# name above) — see graph.py.
# LLM_BASE_URL="http://localhost:9000/v1"
