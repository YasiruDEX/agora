# Department Configuration Parameters
DEPARTMENT_NAME="Permits & Licensing Department"
DEPARTMENT_CODE="PL"
KB_NAMESPACE="permits-licensing"
WELCOME_MESSAGE="Hello! How can I assist you with county permits today?"
SUPPORT_EMAIL_CONTACT="permits@riversidecounty.gov"
OFFICE_HOURS_INFO="Weekdays 9:00 AM - 3:00 PM"

# Remote MCP Server Endpoint(s). When set, this is a comma-separated list of
# streamable-http MCP endpoint URLs (the contract used by the WSO2 Agent
# Manager "local-kb" tool configuration's MCP proxy). Leave unset for plain
# local dev -- graph.py then falls back to a single local server at
# http://localhost:9001/sse over legacy SSE (MCP_TRANSPORT=sse).
# LOCAL_KB_URL="https://your-mcp-proxy.example.com/mcp"

# Optional: sent as the X-API-Key header when LOCAL_KB_URL is set.
# LOCAL_KB_API_KEY=""

# Model & Execution Runtime Settings
LLM_PROVIDER_KEY="azure-openai-gov"
LLM_MODEL_NAME="gpt-4o"
MODEL_TEMPERATURE="0.1"
MAX_TOKENS="1000"
